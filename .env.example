# Firebase Configuration (Get these from Firebase Console > Project settings > General > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional App Check site key (reCAPTCHA v3)
VITE_APPCHECK_SITE_KEY=

# Initial/Default Admin Email
VITE_ADMIN_EMAIL=

# Optional custom Firestore database ID (leave empty to use default database)
VITE_FIRESTORE_DATABASE_ID=
